# Database Setup (Postgres container)
POSTGRES_USER=turnero_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=turnero_db

# Backend DB Connection
# Si usás Docker Compose, DB_HOST es 'db' (nombre del servicio). Si corrés local sin Docker, es 'localhost'.
DB_HOST=db
DB_USER=turnero_user
DB_PASSWORD=your_secure_password
DB_NAME=turnero_db
DB_PORT=5432

# Authentication
# Cambiá esto por una cadena aleatoria de 32 caracteres (ej: openssl rand -hex 32)
JWT_SECRET=change_this_to_a_secure_secret_in_production

# App Config
PORT=8080
